// Windows resource script for Yozora.exe.
//
// Configured by CMake from this template (see CMakeLists.txt), so the version in
// the file properties, the installer and the About page all come from the single
// PROJECT_VERSION and cannot drift apart. It used to be a plain .rc with the
// numbers typed in, and they did drift: the FILEVERSION said 0.1 while the
// string table said 0.2.1 and the binary said 0.2.2.
//
// Only compiled on Windows. It attaches the application icon and the version
// information.
#include <winver.h>

// Quoted because the source tree can sit under a path with spaces in it.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/installer/yozora.ico"

#define YOZORA_VER_MAJOR @PROJECT_VERSION_MAJOR@
#define YOZORA_VER_MINOR @PROJECT_VERSION_MINOR@
#define YOZORA_VER_PATCH @PROJECT_VERSION_PATCH@
#define YOZORA_VER_BUILD 0

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    YOZORA_VER_MAJOR, YOZORA_VER_MINOR, YOZORA_VER_PATCH, YOZORA_VER_BUILD
    PRODUCTVERSION YOZORA_VER_MAJOR, YOZORA_VER_MINOR, YOZORA_VER_PATCH, YOZORA_VER_BUILD
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "The Yozora Browser Authors"
            VALUE "FileDescription",  "Yozora Browser"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "Yozora"
            VALUE "OriginalFilename", "Yozora.exe"
            VALUE "ProductName",      "Yozora Browser"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
