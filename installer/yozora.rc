// Windows resource script for Yozora.exe.
//
// Only compiled on Windows. It attaches the application icon and the version
// information so the file properties, installer and task manager all report the
// same version as the CMake project.
#include <winver.h>

IDI_ICON1 ICON "yozora.ico"

#define YOZORA_VER_MAJOR 0
#define YOZORA_VER_MINOR 1
#define YOZORA_VER_PATCH 0
#define YOZORA_VER_BUILD 0

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    YOZORA_VER_MAJOR, YOZORA_VER_MINOR, YOZORA_VER_PATCH, YOZORA_VER_BUILD
    PRODUCTVERSION YOZORA_VER_MAJOR, YOZORA_VER_MINOR, YOZORA_VER_PATCH, YOZORA_VER_BUILD
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "The Yozora Browser Authors"
            VALUE "FileDescription",  "Yozora Browser"
            VALUE "FileVersion",      "0.2.1.0"
            VALUE "InternalName",     "Yozora"
            VALUE "OriginalFilename", "Yozora.exe"
            VALUE "ProductName",      "Yozora Browser"
            VALUE "ProductVersion",   "0.2.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
