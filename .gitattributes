# Normalise line endings: the repository stores LF, Windows checkouts get CRLF.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.rc   text eol=crlf
*.sln  text eol=crlf
*.vcxproj text eol=crlf

*.cpp text
*.h   text
*.hpp text
*.in  text
*.py  text
*.yml text
*.qrc text
*.md  text
*.svg text

*.ttf binary
*.otf binary

*.ico binary
*.png binary
*.bmp binary
