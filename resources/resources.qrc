<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <file alias="yozora.svg">icons/yozora.svg</file>
        <file alias="yozora.png">icons/yozora.png</file>
        <file alias="yozora-16.png">icons/yozora-16.png</file>
        <file alias="yozora-24.png">icons/yozora-24.png</file>
        <file alias="yozora-32.png">icons/yozora-32.png</file>
        <file alias="yozora-48.png">icons/yozora-48.png</file>
        <file alias="yozora-64.png">icons/yozora-64.png</file>
        <file alias="yozora-128.png">icons/yozora-128.png</file>
        <file alias="yozora-256.png">icons/yozora-256.png</file>
    </qresource>
    <qresource prefix="/privacy">
        <file alias="trackers.txt">privacy/trackers.txt</file>
        <file alias="ads.txt">privacy/ads.txt</file>
    </qresource>
    <!-- Bundled typefaces, generated by installer/make_fonts.py. -->
    <qresource prefix="/fonts">
        <file alias="Inter-Regular.ttf">fonts/Inter-Regular.ttf</file>
        <file alias="Inter-Medium.ttf">fonts/Inter-Medium.ttf</file>
        <file alias="Inter-SemiBold.ttf">fonts/Inter-SemiBold.ttf</file>
        <file alias="Inter-Bold.ttf">fonts/Inter-Bold.ttf</file>
        <file alias="SpaceGrotesk-Medium.ttf">fonts/SpaceGrotesk-Medium.ttf</file>
        <file alias="SpaceGrotesk-Bold.ttf">fonts/SpaceGrotesk-Bold.ttf</file>
    </qresource>
</RCC>
